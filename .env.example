# Base de datos PostgreSQL
# Local: ambas variables con la misma cadena.
# Supabase (botón Connect → ORMs → Prisma), reemplazando [YOUR-PASSWORD]:
#   DATABASE_URL = Transaction pooler (puerto 6543) + ?pgbouncer=true&connection_limit=1
#   DIRECT_URL   = Session pooler (puerto 5432)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Clave de la API de Gemini (Google AI Studio) para el Copiloto IA
GEMINI_API_KEY=""
# Opcional: modelo preferido (si falla, se usa la cadena de respaldo)
# GEMINI_MODEL=""
