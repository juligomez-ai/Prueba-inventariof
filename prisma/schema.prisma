// SYNTHEX · Manufactura e Inventario para Cosmética Natural (Fase 1)
// Convención: los códigos que ve el negocio (estados, tipos, movimientos) están en español.
// Cantidades en Decimal(14,4) en la unidad base del producto; dinero en Decimal(16,2|4).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // app (Supabase: transaction pooler, puerto 6543)
  directUrl = env("DIRECT_URL") // migraciones (Supabase: session pooler, puerto 5432)
}

// ───────────────────────── Enumeraciones ─────────────────────────

enum TipoProducto {
  MATERIA_PRIMA
  EMPAQUE
  PRODUCTO_TERMINADO
}

enum TipoBodega {
  MATERIAS_PRIMAS
  EMPAQUE
  PRODUCCION
  PRODUCTO_TERMINADO
}

enum EstadoLote {
  DISPONIBLE
  CUARENTENA
  BLOQUEADO
  VENCIDO
}

enum OrigenLote {
  COMPRA
  PRODUCCION
  AJUSTE
}

enum EstadoBulto {
  SELLADO
  ABIERTO
  VACIO
  DADO_DE_BAJA
}

/// Tipos de movimiento con su sigla internacional (ver shared/labels.ts)
enum TipoMovimiento {
  ENT_COMPRA // GR  · Goods Receipt
  ENT_PRODUCCION // FGR · Finished Goods Receipt
  SAL_CONSUMO // MI  · Material Issue
  SAL_VENTA // GI  · Goods Issue
  TRASLADO_SAL // STO · Stock Transfer Order
  TRASLADO_ENT // STO
  AJUSTE_ENT // ADJ
  AJUSTE_SAL // ADJ
  BAJA // SCR · Scrap / Write-off
  INV_INICIAL // OB  · Opening Balance
}

enum TipoDocumento {
  OC // PO  · Purchase Order
  OP // MO  · Manufacturing Order
  REM // DN  · Delivery Note (remisión de entrega)
  AJ // ADJ
  CC // Cycle Count
  TR // STO
}

enum EstadoOC {
  BORRADOR
  ENVIADA
  EN_TRANSITO
  RECIBIDA_PARCIAL
  RECIBIDA
  ANULADA
}

enum EstadoOP {
  BORRADOR
  EN_PROCESO
  COMPLETADA
  ANULADA
}

enum EstadoDespacho {
  PENDIENTE
  EN_ALISTAMIENTO
  DESPACHADO
  EN_TRANSITO
  ENTREGADO
  NOVEDAD
  DEVUELTO
}

enum DireccionEnvio {
  ENTRANTE
  SALIENTE
}

enum EstadoEnvio {
  CREADO
  DESPACHADO
  EN_TRANSITO
  EN_CIUDAD_DESTINO
  ENTREGADO
  NOVEDAD
}

enum EstadoConteo {
  EN_CURSO
  EN_REVISION
  APROBADO
  ANULADO
}

enum MotivoAjuste {
  MERMA_PROCESO
  DANADO
  VENCIDO
  MUESTRA_OBSEQUIO
  ERROR_REGISTRO
  INVENTARIO_INICIAL
  CONTEO
}

// ───────────────────────── Catálogo y bodegas ─────────────────────────

model Product {
  id                  String       @id @default(cuid())
  sku                 String       @unique
  name                String
  shortName           String? // nombre corto para la etiqueta térmica
  category            String
  type                TipoProducto
  baseUnit            String // kg | L | und
  barcode             String?      @unique // código del fabricante (EAN-13) si lo tiene
  tracksLot           Boolean      @default(false)
  tracksExpiry        Boolean      @default(false)
  shelfLifeDays       Int? // vida útil para calcular vencimiento al producir
  minStock            Decimal      @default(0) @db.Decimal(14, 4)
  safetyStock         Decimal      @default(0) @db.Decimal(14, 4)
  leadTimeDays        Int          @default(7)
  avgCost             Decimal      @default(0) @db.Decimal(16, 4) // promedio ponderado vigente
  salePrice           Decimal?     @db.Decimal(16, 2)
  nsoCode             String? // Notificación Sanitaria Obligatoria INVIMA
  nsoExpiry           DateTime?
  defaultPackSize     Decimal?     @db.Decimal(14, 4) // ej. 24 cremas por caja, 25 kg por saco
  preferredSupplierId String?
  preferredSupplier   Supplier?    @relation(fields: [preferredSupplierId], references: [id])
  archived            Boolean      @default(false)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  conversions       UnitConversion[]
  lots              Lot[]
  containers        Container[]
  movements         StockMovement[]
  recipe            Recipe?          @relation("RecipeOutput")
  usedIn            RecipeItem[]
  productionOrders  ProductionOrder[]
  productionLines   ProductionLine[]
  purchaseLines     PurchaseOrderLine[]
  dispatchLines     DispatchLine[]
  countItems        CycleCountItem[]
  countLines        CycleCountLine[]
  reservations      Reservation[]
}

/// Unidad de compra → unidad base (RF-1.3). Ej.: "Garrafa 20 L" = 20
model UnitConversion {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  unit      String
  factor    Decimal @db.Decimal(14, 4)

  @@unique([productId, unit])
}

model Warehouse {
  id        String     @id @default(cuid())
  code      String     @unique
  name      String
  type      TipoBodega
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())

  containers   Container[]
  movements    StockMovement[] @relation("MovementWarehouse")
  movementsTo  StockMovement[] @relation("MovementToWarehouse")
  counts       CycleCount[]
}

// ───────────────────────── Lotes, bultos y movimientos ─────────────────────────

model Lot {
  id          String     @id @default(cuid())
  productId   String
  product     Product    @relation(fields: [productId], references: [id])
  code        String
  expiryDate  DateTime?
  status      EstadoLote @default(DISPONIBLE)
  supplierLot String?
  sourceType  OrigenLote
  sourceRef   String? // OC-0007 / OP-0001 / AJ-0003
  supplierId  String?
  supplier    Supplier?  @relation(fields: [supplierId], references: [id])
  productionOrderId String? @unique
  productionOrder   ProductionOrder? @relation("OutputLot", fields: [productionOrderId], references: [id])
  createdAt   DateTime   @default(now())

  containers    Container[]
  movements     StockMovement[]
  statusChanges LotStatusChange[]

  @@unique([productId, code])
}

model LotStatusChange {
  id         String     @id @default(cuid())
  lotId      String
  lot        Lot        @relation(fields: [lotId], references: [id], onDelete: Cascade)
  fromStatus EstadoLote
  toStatus   EstadoLote
  reason     String
  userName   String
  createdAt  DateTime   @default(now())
}

/// Bulto serializado (M5.1): saco, garrafa o caja con un solo producto y un solo lote.
model Container {
  id          String      @id @default(cuid())
  serial      String      @unique // <SKU>-<000123>
  productId   String
  product     Product     @relation(fields: [productId], references: [id])
  lotId       String?
  lot         Lot?        @relation(fields: [lotId], references: [id])
  warehouseId String
  warehouse   Warehouse   @relation(fields: [warehouseId], references: [id])
  initialQty  Decimal     @db.Decimal(14, 4)
  currentQty  Decimal     @db.Decimal(14, 4)
  status      EstadoBulto @default(SELLADO)
  sourceType  OrigenLote
  sourceRef   String?
  openedAt    DateTime?
  createdAt   DateTime    @default(now())

  movements     StockMovement[]
  reservations  Reservation[]
  allocations   DispatchAllocation[]
  countLines    CycleCountLine[]

  @@index([productId, warehouseId])
}

/// Kardex inmutable con trazabilidad completa (RF-3.5)
model StockMovement {
  id                String         @id @default(cuid())
  number            Int            @unique // consecutivo del Kardex
  type              TipoMovimiento
  productId         String
  product           Product        @relation(fields: [productId], references: [id])
  warehouseId       String
  warehouse         Warehouse      @relation("MovementWarehouse", fields: [warehouseId], references: [id])
  toWarehouseId     String? // traslados: bodega contraparte
  toWarehouse       Warehouse?     @relation("MovementToWarehouse", fields: [toWarehouseId], references: [id])
  lotId             String?
  lot               Lot?           @relation(fields: [lotId], references: [id])
  containerId       String?
  container         Container?     @relation(fields: [containerId], references: [id])
  quantity          Decimal        @db.Decimal(14, 4) // + entrada / − salida
  unitCost          Decimal        @db.Decimal(16, 4)
  totalValue        Decimal        @db.Decimal(16, 2)
  avgCostBefore     Decimal        @db.Decimal(16, 4)
  avgCostAfter      Decimal        @db.Decimal(16, 4)
  balanceBefore     Decimal        @db.Decimal(14, 4) // saldo total del producto
  balanceAfter      Decimal        @db.Decimal(14, 4)
  documentType      TipoDocumento
  documentId        String
  documentNumber    String
  remissionNumber   String? // remisión de entrega (REM) o del proveedor
  partyType         String? // PROVEEDOR | CLIENTE
  partyName         String?
  reason            String?
  relatedMovementId String?
  userName          String
  createdAt         DateTime       @default(now())

  @@index([productId, createdAt])
  @@index([documentType, documentId])
  @@index([lotId])
}

// ───────────────────────── Compras y tracking ─────────────────────────

model Supplier {
  id              String   @id @default(cuid())
  taxId           String   @unique // NIT
  name            String
  contactName     String?
  phone           String?
  email           String?
  city            String?
  paymentTermDays Int      @default(30)
  leadTimeDays    Int      @default(7)
  createdAt       DateTime @default(now())

  products       Product[]
  purchaseOrders PurchaseOrder[]
  lots           Lot[]
}

model PurchaseOrder {
  id           String              @id @default(cuid())
  code         String              @unique // OC-0001
  supplierId   String
  supplier     Supplier            @relation(fields: [supplierId], references: [id])
  status       EstadoOC            @default(BORRADOR)
  expectedDate DateTime?
  notes        String?
  createdByAI  Boolean             @default(false)
  sentAt       DateTime?
  createdAt    DateTime            @default(now())
  lines        PurchaseOrderLine[]
  receipts     Receipt[]
  shipments    Shipment[]
}

model PurchaseOrderLine {
  id          String        @id @default(cuid())
  orderId     String
  order       PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product       @relation(fields: [productId], references: [id])
  quantity    Decimal       @db.Decimal(14, 4) // en unidad de compra
  unit        String // unidad de compra (base o conversión)
  factor      Decimal       @db.Decimal(14, 4) // unidad de compra → base
  unitPrice   Decimal       @db.Decimal(16, 2) // por unidad de compra, sin IVA
  taxRate     Decimal       @default(19) @db.Decimal(5, 2)
  receivedQty Decimal       @default(0) @db.Decimal(14, 4) // en unidad base
  receiptLines ReceiptLine[]
}

model Receipt {
  id               String        @id @default(cuid())
  code             String        @unique // REC-0001
  orderId          String
  order            PurchaseOrder @relation(fields: [orderId], references: [id])
  supplierRemission String // número de remisión del proveedor (obligatorio)
  warehouseId      String
  notes            String?
  userName         String
  createdAt        DateTime      @default(now())
  lines            ReceiptLine[]
}

model ReceiptLine {
  id         String            @id @default(cuid())
  receiptId  String
  receipt    Receipt           @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  lineId     String
  line       PurchaseOrderLine @relation(fields: [lineId], references: [id])
  quantity   Decimal           @db.Decimal(14, 4) // base
  lotCode    String?
  expiryDate DateTime?
  containers Int
}

model Carrier {
  id                  String     @id @default(cuid())
  name                String     @unique
  trackingUrlTemplate String? // https://…?guia={guia}
  acceptsParam        Boolean    @default(true)
  shipments           Shipment[]
}

model Shipment {
  id              String          @id @default(cuid())
  direction       DireccionEnvio
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder?  @relation(fields: [purchaseOrderId], references: [id])
  dispatchId      String?         @unique
  dispatch        Dispatch?       @relation(fields: [dispatchId], references: [id])
  carrierId       String
  carrier         Carrier         @relation(fields: [carrierId], references: [id])
  trackingNumber  String
  shippedAt       DateTime?
  eta             DateTime?
  status          EstadoEnvio     @default(CREADO)
  createdAt       DateTime        @default(now())
  events          ShipmentEvent[]
}

model ShipmentEvent {
  id         String      @id @default(cuid())
  shipmentId String
  shipment   Shipment    @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status     EstadoEnvio
  note       String?
  occurredAt DateTime    @default(now())
  userName   String
}

// ───────────────────────── Fórmulas y producción ─────────────────────────

model Recipe {
  id            String       @id @default(cuid())
  productId     String       @unique // una fórmula por producto terminado (RF-8.5)
  product       Product      @relation("RecipeOutput", fields: [productId], references: [id])
  name          String
  yieldQuantity Decimal      @db.Decimal(14, 4) // rendimiento, en unidad base del producto
  instructions  String?
  createdByAI   Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  items         RecipeItem[]
  orders        ProductionOrder[]
}

model RecipeItem {
  id           String  @id @default(cuid())
  recipeId     String
  recipe       Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Product @relation(fields: [ingredientId], references: [id])
  quantity     Decimal @db.Decimal(14, 4) // en unidad base del insumo, para el rendimiento

  @@unique([recipeId, ingredientId])
}

model ProductionOrder {
  id              String     @id @default(cuid())
  code            String     @unique // OP-0001
  productId       String
  product         Product    @relation(fields: [productId], references: [id])
  recipeId        String
  recipe          Recipe     @relation(fields: [recipeId], references: [id])
  plannedQty      Decimal    @db.Decimal(14, 4)
  producedQty     Decimal?   @db.Decimal(14, 4)
  status          EstadoOP   @default(BORRADOR)
  plannedDate     DateTime?
  notes           String?
  theoreticalCost Decimal?   @db.Decimal(16, 2)
  actualCost      Decimal?   @db.Decimal(16, 2)
  createdByAI     Boolean    @default(false)
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime   @default(now())
  outputLot       Lot?       @relation("OutputLot")
  lines           ProductionLine[]
  reservations    Reservation[]
}

/// Copia de la fórmula al crear la OP (RN-8.3)
model ProductionLine {
  id          String          @id @default(cuid())
  orderId     String
  order       ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product         @relation(fields: [productId], references: [id])
  plannedQty  Decimal         @db.Decimal(14, 4)
  consumedQty Decimal?        @db.Decimal(14, 4)
  unitCost    Decimal?        @db.Decimal(16, 4)
}

/// Reserva de un bulto para una OP (FEFO)
model Reservation {
  id          String          @id @default(cuid())
  orderId     String
  order       ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  containerId String
  container   Container       @relation(fields: [containerId], references: [id])
  productId   String
  product     Product         @relation(fields: [productId], references: [id])
  quantity    Decimal         @db.Decimal(14, 4)
}

// ───────────────────────── Despachos ─────────────────────────

model Dispatch {
  id            String         @id @default(cuid())
  code          String         @unique // REM-0001 (remisión de entrega)
  customerName  String
  customerTaxId String
  address       String
  city          String
  salesRef      String? // pedido o factura de SYNTHEX
  status        EstadoDespacho @default(PENDIENTE)
  freightCost   Decimal?       @db.Decimal(16, 2)
  notes         String?
  proofDataUrl  String? // remisión firmada (POD)
  shippedAt     DateTime?
  deliveredAt   DateTime?
  createdAt     DateTime       @default(now())
  lines         DispatchLine[]
  allocations   DispatchAllocation[]
  shipment      Shipment?
}

model DispatchLine {
  id         String   @id @default(cuid())
  dispatchId String
  dispatch   Dispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Decimal  @db.Decimal(14, 4)
}

/// Bultos asignados (FEFO) al alistar; picked = verificado con escáner
model DispatchAllocation {
  id          String    @id @default(cuid())
  dispatchId  String
  dispatch    Dispatch  @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  containerId String
  container   Container @relation(fields: [containerId], references: [id])
  quantity    Decimal   @db.Decimal(14, 4)
  picked      Boolean   @default(false)
}

// ───────────────────────── Conteo cíclico, ajustes y traslados ─────────────────────────

model CycleCount {
  id          String           @id @default(cuid())
  code        String           @unique // CC-0001
  warehouseId String
  warehouse   Warehouse        @relation(fields: [warehouseId], references: [id])
  status      EstadoConteo     @default(EN_CURSO)
  notes       String?
  userName    String
  createdAt   DateTime         @default(now())
  closedAt    DateTime?
  approvedAt  DateTime?
  items       CycleCountItem[]
  lines       CycleCountLine[]
}

model CycleCountItem {
  id        String     @id @default(cuid())
  countId   String
  count     CycleCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  productId String
  product   Product    @relation(fields: [productId], references: [id])

  @@unique([countId, productId])
}

model CycleCountLine {
  id          String     @id @default(cuid())
  countId     String
  count       CycleCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  productId   String
  product     Product    @relation(fields: [productId], references: [id])
  containerId String?
  container   Container? @relation(fields: [containerId], references: [id])
  systemQty   Decimal    @db.Decimal(14, 4) // stock del bulto al momento del escaneo
  countedQty  Decimal    @db.Decimal(14, 4)
  sealedOk    Boolean    @default(false) // confirmado como caja sellada con un escaneo
  notFound    Boolean    @default(false) // bulto esperado que no se escaneó
  comment     String?
  scannedAt   DateTime   @default(now())

  @@unique([countId, containerId])
}

model Adjustment {
  id          String       @id @default(cuid())
  code        String       @unique // AJ-0001
  reason      MotivoAjuste
  notes       String?
  userName    String
  createdAt   DateTime     @default(now())
}

model Transfer {
  id              String   @id @default(cuid())
  code            String   @unique // TR-0001
  fromWarehouseId String
  toWarehouseId   String
  notes           String?
  userName        String
  createdAt       DateTime @default(now())
}

model Sequence {
  name  String @id
  value Int    @default(0)
}
